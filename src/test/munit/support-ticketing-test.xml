	<munit:config name="support-ticketing-test.xml" />
	<munit:test name="support-ticketing-test-support-ticketingFlowTest" doc:id="33412f51-632f-4598-aacf-33393d453a5f" description="Test">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock when" doc:id="0894a6de-a08a-4dd8-9541-15953712c5c8" processor="flow">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="support-ticketingFlow" attributeName="name" />
					<munit-tools:with-attribute whereValue="5082a6f9-3ee2-4273-be6e-6cdadd0d4c0d" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[[{&#10;	id: "mock-ticket-id",success: true,errors: [], items: []&#10;}]]' encoding="UTF-16" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="f0ff9ec4-6ad8-403f-afac-1a62ff82635f" >
