			</munit:set-event>
			<flow-ref doc:name="Flow-ref to support-ticketingFlow" doc:id="8071784f-a42e-45dc-9655-fb13b3235e04" name="support-ticketingFlow"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that" doc:id="65c18f8a-5121-4b2d-8e66-8fc332bd6246" message="Ticket flow should return a response" expression="#[payload != null]" is="#[MunitTools::notNullValue()]"/>
		</munit:validation>
	</munit:test>


</mule>
